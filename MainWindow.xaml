<Window x:Class="PingBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PingBoost · Network Lab" Icon="Assets/PingBoost.ico" Width="1100" Height="800"
        MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="↗" Foreground="White" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PingBoost" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="NETWORK LAB" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" FontWeight="Bold" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Content="⚙" FontFamily="Segoe UI Symbol" FontSize="22"
                        Width="48" Height="44" Padding="0" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" ClipToBounds="False"
                        ToolTip="Настройки" Click="Settings_Click"
                        Background="White" Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="СЕТЬ И АДАПТЕРЫ" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="AdapterText" Text="Загрузка сетевых подключений…" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Замеры идут по маршруту Windows; выбранный адаптер пока не закрепляется за тестом."
                               Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Обновить" VerticalAlignment="Center"
                        Click="RefreshAdapters_Click" Background="{StaticResource SoftFillBrush}"
                        Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Тесты">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ЗАДЕРЖКА ПОСЛЕ ПРОСТОЯ" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Сравнивает ping сразу после пробуждения с ping после короткой паузы. Повторите несколько циклов, чтобы увидеть, добавляет ли сотовая сеть задержку после простоя."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="IdleTargetTextBox" Text="1.1.1.1" Width="170" />
                                        <TextBlock Text="Пауза" VerticalAlignment="Center" Margin="14,0,7,0"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <ComboBox x:Name="IdleIntervalComboBox" Width="110" SelectedIndex="1"
                                                  VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="5 секунд" Tag="5" />
                                            <ComboBoxItem Content="15 секунд" Tag="15" />
                                            <ComboBoxItem Content="30 секунд" Tag="30" />
                                            <ComboBoxItem Content="60 секунд" Tag="60" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="IdleTestButton" Content="Запустить 5 циклов" Click="IdleTest_Click" />
                                        <Button x:Name="CompareKeepAliveTestButton" Content="Сравнить keepalive"
                                                Margin="8,0,0,0" Click="CompareKeepAliveTest_Click"
                                                Background="{StaticResource SoftFillBrush}" Foreground="{StaticResource TextBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" />
                                        <Button x:Name="StopIdleTestButton" Content="Остановить" Margin="8,0,0,0"
                                                Click="StopIdleTest_Click" IsEnabled="False"
                                                Background="{StaticResource SoftFillBrush}" Foreground="{StaticResource TextBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="IdleTestSummaryText" Text="Средний сдвиг после паузы: —"
                                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <DataGrid x:Name="IdleResultsGrid" ItemsSource="{Binding IdleRows}" MinHeight="120"
                                          MaxHeight="220" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Режим" Binding="{Binding Mode}" Width="*" />
                                        <DataGridTextColumn Header="Цикл" Binding="{Binding Round}" Width="65" />
                                        <DataGridTextColumn Header="Сразу после трафика" Binding="{Binding WarmText}" Width="*" />
                                        <DataGridTextColumn Header="После паузы" Binding="{Binding IdleText}" Width="*" />
                                        <DataGridTextColumn Header="Разница" Binding="{Binding DeltaText}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ИГРА" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Процесс игры используется на вкладках «Оптимизация» и «UDP-монитор». Выберите его из списка (процессы с открытыми UDP-портами) или введите имя без .exe, например cs2."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Процесс" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" />
                                    <ComboBox x:Name="GameProcessComboBox" Width="220" IsEditable="True" ToolTip="Имя процесса без .exe" />
                                    <Button Content="Обновить" Margin="6,0,0,0" Click="RefreshProcesses_Click" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                                <TextBlock x:Name="GameStatusText" Text="" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ОПЦИОНАЛЬНЫЙ KEEPALIVE" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Периодически отправляет небольшой HTTPS-запрос. Может помочь удержать соединение активным, но результат зависит от модема и оператора; это расходует трафик и заряд. По умолчанию выключен."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="KeepAliveUrlTextBox" Text="https://www.google.com/generate_204"
                                                 Width="300" />
                                        <TextBlock Text="Интервал" VerticalAlignment="Center" Margin="14,0,7,0"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <ComboBox x:Name="KeepAliveIntervalComboBox" Width="105" SelectedIndex="2"
                                                  VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="2 секунды" Tag="2" />
                                            <ComboBoxItem Content="5 секунд" Tag="5" />
                                            <ComboBoxItem Content="10 секунд" Tag="10" />
                                            <ComboBoxItem Content="20 секунд" Tag="20" />
                                            <ComboBoxItem Content="30 секунд" Tag="30" />
                                            <ComboBoxItem Content="60 секунд" Tag="60" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="StartKeepAliveButton" Content="Включить" Click="StartKeepAlive_Click" />
                                        <Button x:Name="StopKeepAliveButton" Content="Остановить" Margin="8,0,0,0"
                                                Click="StopKeepAlive_Click" IsEnabled="False"
                                                Background="{StaticResource SoftFillBrush}" Foreground="{StaticResource TextBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="KeepAliveStatusText" Text="Выключен. Запросы не отправляются."
                                           FontSize="11" Margin="0,10,0,0" />
                                <TextBlock Text="Для чистого теста задержки после простоя остановите keepalive. Адрес должен быть HTTPS; используйте только доверенный endpoint. Интервал 2 с расходует больше трафика и заряда."
                                           Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BUFFERBLOAT · ЗАДЕРЖКА ПОД НАГРУЗКОЙ" FontSize="12" FontWeight="Bold" />
                                    <TextBlock Text="Официальный тест Waveform измеряет idle / download / upload latency и jitter, пока канал нагружается. Результат и оценка A+–F показываются на сайте; PingBoost не считывает их автоматически."
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,14,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Открыть Waveform…" VerticalAlignment="Center"
                                        Click="OpenWaveform_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Обзор и сравнение">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ЦЕЛИ ТЕСТА" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="TargetsSummaryText" Text="Выбрано: —" FontSize="11" Margin="0,4,0,6"
                                               TextWrapping="Wrap" />
                                    <Expander x:Name="TargetsExpander" Header="Готовые DNS-серверы и свои адреса" IsExpanded="False">
                                        <StackPanel Margin="0,8,0,0">
                                            <WrapPanel x:Name="TargetsPanel" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBox x:Name="CustomTargetTextBox" Width="220" ToolTip="IP-адрес или DNS-имя" />
                                                <Button Content="Добавить" Margin="8,0,0,0" Click="AddCustomTarget_Click" Style="{StaticResource SecondaryButton}" />
                                            </StackPanel>
                                            <TextBlock x:Name="CustomTargetStatusText" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                            Margin="12,0,0,0">
                                    <Button x:Name="StartButton" Content="Начать тест" Click="Start_Click" />
                                    <Button x:Name="StopButton" Content="Остановить" Margin="8,0,0,0"
                                            Click="Stop_Click" IsEnabled="False"
                                            Background="{StaticResource SoftFillBrush}"
                                            Foreground="{StaticResource TextBrush}"
                                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="12" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="ПОСЛЕДНИЙ PING" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="PingValue" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="12" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="СРЕДНИЙ ДЖИТТЕР" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="JitterValue" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="12" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="ПОТЕРИ" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="LossValue" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="125" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="ЗАДЕРЖКА ВО ВРЕМЕНИ" FontSize="11" FontWeight="Bold" />
                                        <TextBlock x:Name="ChartCaption" Text="ICMP · последние измерения"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox x:Name="ChartTargetComboBox" Width="180" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" SelectionChanged="ChartTarget_SelectionChanged" />
                                </Grid>
                                <Canvas x:Name="ChartCanvas" Grid.Row="1" ClipToBounds="True" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="СРАВНЕНИЕ ЦЕЛЕЙ" FontSize="11" FontWeight="Bold" Margin="2,0,0,8" />
                                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding TargetRows}" MinHeight="105"
                                          MaxHeight="180" SelectionChanged="ResultsGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Цель" Binding="{Binding Host}" Width="2*" />
                                        <DataGridTextColumn Header="Сейчас" Binding="{Binding LatestText}" Width="*" />
                                        <DataGridTextColumn Header="Среднее" Binding="{Binding AverageText}" Width="*" />
                                        <DataGridTextColumn Header="Джиттер" Binding="{Binding JitterText}" Width="*" />
                                        <DataGridTextColumn Header="Потери" Binding="{Binding LossText}" Width="*" />
                                        <DataGridTextColumn Header="Ответы" Binding="{Binding SamplesText}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="РЕЗУЛЬТАТЫ ДО / ПОСЛЕ" FontSize="11" FontWeight="Bold" />
                                    <TextBlock x:Name="ComparisonText" Text="Снимите исходный замер, измените только одну настройку, затем сравните результаты."
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,12,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Сохранить ДО" Click="CaptureBaseline_Click"
                                            Background="{StaticResource SoftFillBrush}" Foreground="{StaticResource TextBrush}"
                                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" />
                                    <Button Content="Сравнить ПОСЛЕ" Margin="8,0,0,0" Click="CompareBaseline_Click" />
                                    <Button Content="Экспорт CSV" Margin="8,0,0,0" Click="ExportCsv_Click"
                                            Background="{StaticResource SoftFillBrush}" Foreground="{StaticResource TextBrush}"
                                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Оптимизация">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                    <StackPanel>
                        <Border x:Name="AdminBanner" Background="#FFF6E5" BorderBrush="#F0D9A8" BorderThickness="1"
                                CornerRadius="12" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Для изменения настроек адаптера и системы нужны права администратора. Измерения и просмотр состояния работают и без них."
                                           TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Grid.Column="1" Content="Перезапустить от администратора" Click="RestartAsAdmin_Click" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="НАСТРОЙКИ АДАПТЕРА И СИСТЕМЫ" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Перед первым изменением PingBoost сохраняет исходные значения. Любое изменение можно отменить кнопками внизу вкладки. Драйверы не устанавливаются."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Адаптер" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" />
                                    <ComboBox x:Name="TuningAdapterComboBox" Width="420" SelectionChanged="TuningAdapter_SelectionChanged" />
                                    <Button Content="Обновить" Margin="8,0,0,0" Click="RefreshTuningAdapters_Click" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                                <StackPanel x:Name="TweaksPanel" Margin="0,12,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="ApplyTweaksButton" Content="Применить выбранное" Click="ApplyTweaks_Click" />
                                    <Button Content="Показать текущее состояние" Margin="8,0,0,0" Click="ShowTuningState_Click" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                                <TextBlock Text="Галочка и пометка «включено» показывают, что пункт действует сейчас. Снять отдельный пункт нельзя, для этого есть кнопки отката ниже. Некоторые параметры перезапускают адаптер: соединение пропадёт на несколько секунд, не применяйте их во время матча."
                                           Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="MTU БЕЗ ФРАГМЕНТАЦИИ" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Находит самый большой пакет, который проходит до узла без фрагментации (аналог ping -f -l). На мобильных каналах фрагментация UDP может давать потери. Для проверки выберите адрес игрового сервера или публичный узел."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="MtuHostTextBox" Text="1.1.1.1" Width="200" />
                                    <Button x:Name="ProbeMtuButton" Content="Подобрать MTU" Margin="8,0,0,0" Click="ProbeMtu_Click" />
                                    <Button x:Name="ApplyMtuButton" Content="Применить найденный MTU" Margin="8,0,0,0" IsEnabled="False"
                                            Click="ApplyMtu_Click" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                                <TextBlock x:Name="MtuResultText" Text="Результат появится здесь." FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="QoS · ПОМЕТКА UDP-ТРАФИКА ИГРЫ (DSCP)" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Windows помечает исходящий UDP-трафик процесса игры (блок «Игра» на вкладке «Тесты») приоритетом DSCP. Помогает на Wi-Fi и в сетях, которые учитывают DSCP; оператор мобильной сети и hotspot-телефон метку могут сбросить."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DSCP" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" />
                                    <ComboBox x:Name="DscpComboBox" Width="200" SelectedIndex="0">
                                        <ComboBoxItem Content="46 · Expedited Forwarding" Tag="46" />
                                        <ComboBoxItem Content="34 · AF41" Tag="34" />
                                        <ComboBoxItem Content="26 · AF31" Tag="26" />
                                    </ComboBox>
                                    <Button Content="Включить для процесса игры" Margin="8,0,0,0" Click="EnableQos_Click" />
                                    <Button Content="Убрать" Margin="8,0,0,0" Click="RemoveQos_Click" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                                <TextBlock x:Name="QosStatusText" Text="Политика не создана." FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ОГРАНИЧЕНИЕ ОТДАЧИ ФОНОВЫХ ПРОГРАММ (BUFFERBLOAT)" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Когда программа забивает исходящий канал, очередь у модема или оператора растёт и пинг в игре подскакивает. Windows ограничит скорость отдачи перечисленных программ политикой QoS. Ограничивается только исходящий трафик; входящий так не ограничить. Не добавляйте сюда саму игру."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <TextBlock Text="Программы (по одной на строку, без .exe)" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox x:Name="ThrottleProcessesTextBox" Text="steam&#x0a;OneDrive" AcceptsReturn="True" Height="56"
                                         VerticalScrollBarVisibility="Auto" Margin="0,4,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Лимит отдачи на программу" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" />
                                    <ComboBox x:Name="ThrottleRateComboBox" Width="130" SelectedIndex="2">
                                        <ComboBoxItem Content="2 Мбит/с" Tag="2" />
                                        <ComboBoxItem Content="5 Мбит/с" Tag="5" />
                                        <ComboBoxItem Content="10 Мбит/с" Tag="10" />
                                        <ComboBoxItem Content="20 Мбит/с" Tag="20" />
                                        <ComboBoxItem Content="30 Мбит/с" Tag="30" />
                                    </ComboBox>
                                    <Button Content="Применить ограничение" Margin="8,0,0,0" Click="EnableThrottle_Click" />
                                    <Button Content="Снять ограничения" Margin="8,0,0,0" Click="RemoveThrottle_Click" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                                <TextBlock Text="Общий потолок отдачи всего ПК" FontWeight="SemiBold" FontSize="11" Margin="0,16,0,0" />
                                <TextBlock Text="Потолок ниже реальной скорости отдачи не даёт компьютеру забивать очередь модема, и пинг под нагрузкой остаётся низким. Игровой трафик идёт на малой скорости и потолка не достигает. Скорость отдачи канала плавает, начните с 40 Мбит/с и проверьте тестом Waveform."
                                           Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Потолок отдачи ПК" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" />
                                    <ComboBox x:Name="GlobalThrottleRateComboBox" Width="130" SelectedIndex="2">
                                        <ComboBoxItem Content="20 Мбит/с" Tag="20" />
                                        <ComboBoxItem Content="30 Мбит/с" Tag="30" />
                                        <ComboBoxItem Content="40 Мбит/с" Tag="40" />
                                        <ComboBoxItem Content="45 Мбит/с" Tag="45" />
                                        <ComboBoxItem Content="50 Мбит/с" Tag="50" />
                                    </ComboBox>
                                    <Button Content="Включить общий потолок" Margin="8,0,0,0" Click="EnableGlobalThrottle_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ThrottleStatusText" Text="Ограничений нет." FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="Подсказка: при исходящей скорости около 58 Мбит/с держите суммарный лимит программ заметно ниже неё. После применения повторите тест Waveform и сравните оценку."
                                           Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ИГРОВОЙ РЕЖИМ" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Временные изменения на время игры. При выключении всё возвращается; если приложение закрыть, режим выключается автоматически."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10" />
                                <CheckBox x:Name="GameModePriorityCheckBox" Content="Высокий приоритет процесса игры" IsChecked="True" Margin="0,0,0,4" />
                                <CheckBox x:Name="GameModePowerCheckBox" Content="Схема питания «Высокая производительность» и Wi-Fi без энергосбережения" IsChecked="True" Margin="0,0,0,4" />
                                <CheckBox x:Name="GameModeServicesCheckBox" Content="Остановить фоновые загрузки (Центр обновления, BITS, Delivery Optimization)" IsChecked="True" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <Button x:Name="GameModeStartButton" Content="Включить игровой режим" Click="GameModeStart_Click" />
                                    <Button x:Name="GameModeStopButton" Content="Выключить" Margin="8,0,0,0" IsEnabled="False"
                                            Click="GameModeStop_Click" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                                <TextBlock x:Name="GameModeStatusText" Text="Выключен." FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ОТКАТ НАСТРОЕК" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="«Вернуть как было» восстанавливает значения, сохранённые перед первым изменением. «Стандартные настройки Windows» выставляет документированные значения по умолчанию для всех параметров, которыми управляет PingBoost, даже если резервной копии нет."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <WrapPanel>
                                    <Button x:Name="RestorePreviousButton" Content="Вернуть как было до PingBoost" Click="RestorePrevious_Click" />
                                    <Button x:Name="ResetDefaultsButton" Content="Сбросить к стандартным настройкам Windows" Margin="8,0,0,0"
                                            Click="ResetDefaults_Click" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                                <TextBox x:Name="TuningLogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Height="170" FontFamily="Consolas" FontSize="11" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="UDP-монитор">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="UDP-трафик игры" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Показывает адреса и порты, с которыми игра обменивается UDP-пакетами, а также скорость приёма и максимальную паузу между принятыми пакетами за последние 10 секунд. Читаются только заголовки (адреса, порты, размер, время), содержимое пакетов не анализируется. Игровой сервер — строка с наибольшим числом пакетов."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="UdpStartButton" Content="Начать наблюдение" Click="UdpStart_Click" />
                            <Button x:Name="UdpStopButton" Content="Остановить" Margin="8,0,0,0" IsEnabled="False"
                                    Click="UdpStop_Click" Style="{StaticResource SecondaryButton}" />
                            <TextBlock x:Name="UdpStatusText" Text="Не запущено (нужны права администратора)." ToolTip="Процесс берётся из блока «Игра» на вкладке «Тесты»; если он пуст, показываются все процессы."
                                       VerticalAlignment="Center" FontSize="11" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="ЛОКАЛЬНЫЕ ПОТЕРИ ЭТОГО ПК" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="UdpLocalText" Text="Появится после начала наблюдения." FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBox x:Name="UdpEventsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="64" FontFamily="Consolas" FontSize="11" Margin="0,6,0,10" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <DataGrid ItemsSource="{Binding UdpRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Процесс" Binding="{Binding ProcessName}" Width="*" />
                                <DataGridTextColumn Header="Удалённый адрес" Binding="{Binding Remote}" Width="2*" />
                                <DataGridTextColumn Header="Отправлено" Binding="{Binding SentPackets}" Width="*" />
                                <DataGridTextColumn Header="Принято" Binding="{Binding ReceivedPackets}" Width="*" />
                                <DataGridTextColumn Header="Приём, пак/с" Binding="{Binding ReceiveRateText}" Width="*" />
                                <DataGridTextColumn Header="Джиттер приёма" Binding="{Binding JitterText}" Width="*" />
                                <DataGridTextColumn Header="Макс. пауза приёма" Binding="{Binding MaxGapText}" Width="*" />
                                <DataGridTextColumn Header="Последний пакет" Binding="{Binding LastReceiveText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"
                               Text="Пауза приёма в сотни миллисекунд при активной игре означает, что от сервера не приходили пакеты: потеря или задержка на пути от сервера. Это не видно по ICMP-пингу до роутера или 1.1.1.1. Сравнивайте паузы с ощущаемыми лагами." />
                </Grid>
            </TabItem>

            <TabItem Header="Маршрут">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Проверка маршрута (traceroute)" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Показывает отвечающие узлы по пути. Таймаут или отсутствие ответа на промежуточном узле не обязательно означает потерю игрового трафика."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <DataGrid x:Name="RouteGrid" ItemsSource="{Binding RouteRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Шаг" Binding="{Binding Hop}" Width="65" />
                                <DataGridTextColumn Header="Узел" Binding="{Binding Address}" Width="2*" />
                                <DataGridTextColumn Header="Задержка" Binding="{Binding LatencyText}" Width="*" />
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RouteHostTextBox" Text="1.1.1.1" Width="240" HorizontalAlignment="Left" />
                        <Button x:Name="TraceButton" Grid.Column="1" Content="Проверить маршрут"
                                Click="TraceRoute_Click" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Text="Измерения ничего не меняют. «Оптимизация» меняет настройки только после подтверждения и всегда откатывается. Результат не гарантирован."
                   Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,12,2,0" />
    </Grid>
</Window>
