<Window x:Class="PingBoost.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки PingBoost" Width="520" Height="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Язык интерфейса" Width="150" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageComboBox" Width="150" SelectedIndex="0" SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="Русский" Tag="ru" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="StartupCheckBox" Content="Запускать вместе с Windows (текущий пользователь)" Margin="0,14,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить настройки" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
