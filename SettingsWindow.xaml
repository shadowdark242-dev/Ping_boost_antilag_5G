<Window x:Class="PingBoost.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки PingBoost" Width="620" Height="680" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,16,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Язык интерфейса" Width="150" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageComboBox" Width="150" SelectedIndex="0" SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="Русский" Tag="ru" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="StartupCheckBox" Content="Запускать вместе с Windows (текущий пользователь)" Margin="0,12,0,0" />
            <TextBlock Text="Профили игр сохраняются локально и содержат параметры целей, записи сессии, теста простоя и keepalive. Профиль не меняет маршрутизацию игрового трафика."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Новый профиль" Click="NewProfile_Click" Margin="0,8,0,0" />
                <ListBox x:Name="ProfilesListBox" SelectionChanged="ProfilesListBox_SelectionChanged" />
            </DockPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Название профиля" />
                <TextBox x:Name="ProfileNameTextBox" Margin="0,4,0,8" />
                <TextBlock Text="Имя процесса игры (необязательно, без .exe)" />
                <TextBox x:Name="ProcessNameTextBox" Margin="0,4,0,8" />
                <TextBlock Text="Цели мониторинга (по одной на строку)" />
                <TextBox x:Name="MonitorTargetsTextBox" Height="55" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Text="Шлюз hotspot / роутера" />
                <TextBox x:Name="GatewayTextBox" Margin="0,4,0,8" />
                <TextBlock Text="Внешняя цель записи сессии" />
                <TextBox x:Name="RemoteTextBox" Margin="0,4,0,8" />
                <TextBlock Text="Цель теста после простоя" />
                <TextBox x:Name="IdleTargetTextBox" Margin="0,4,0,8" />
                <TextBlock Text="Пауза теста простоя (секунды)" />
                <TextBox x:Name="IdleSecondsTextBox" Margin="0,4,0,8" />
                <TextBlock Text="HTTPS keepalive endpoint" />
                <TextBox x:Name="KeepAliveUrlTextBox" Margin="0,4,0,8" />
                <TextBlock Text="Интервал keepalive (секунды)" />
                <TextBox x:Name="KeepAliveSecondsTextBox" Margin="0,4,0,8" />
            </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Удалить профиль" Click="DeleteProfile_Click" Margin="0,0,8,0" />
            <Button Content="Сохранить настройки" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
